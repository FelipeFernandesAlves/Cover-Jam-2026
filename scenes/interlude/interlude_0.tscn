[sub_resource type="Resource" id="Resource_qosdh"]
script = ExtResource("2_tn21x")
texto = "É, essa torre não é uma torre qualquer. E é aqui que sua verdadeira jornada começa. Vamos ver você colocar seus ensinamentos na prática. Hoje você vai fazer tudo por conta própria. Eu vou só observar"
